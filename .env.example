# Variables del servidor. En Vercel se cargan en Settings → Environment Variables.
# Nunca van al repo: .gitignore excluye .env*

# GoHighLevel — Private Integration token (Configuración → Private Integrations)
GHL_TOKEN=
# ID de la subcuenta
GHL_LOCATION_ID=

# Conversions API de Meta (Events Manager → tu píxel → Configuración → generar token).
# Sin esto la landing sigue midiendo por navegador, pero se pierden los eventos
# que bloquean iOS, Safari y los bloqueadores de anuncios.
META_CAPI_TOKEN=

# Sólo para depurar. Con esto los eventos de servidor aparecen en
# Events Manager → Probar eventos (el código sale de esa misma pantalla).
# Los eventos marcados NO cuentan para los informes ni para la optimización:
# se pone para una prueba y se saca.
META_TEST_EVENT_CODE=

# Secreto propio para el webhook de citas de GHL. Inventar una cadena larga y
# usarla en la URL del workflow: https://www.genesisecom.com/api/ghl/cita?token=...
GHL_WEBHOOK_SECRET=

# Base del panel de tracking (/tracking). Supabase → Settings → API.
# Sin estas dos variables la landing funciona igual: el lead sigue llegando a
# GoHighLevel y a Meta, sólo que el panel se queda sin datos.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Contraseña para entrar a /tracking. Inventar una larga.
TRACKING_PASSWORD=
